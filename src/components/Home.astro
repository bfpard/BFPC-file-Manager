---
import FeatureCard from '../components/FeatureCard.astro';
---

<main
  class="min-h-screen bg-slate-50/50 px-4 py-16 sm:px-6 lg:px-8 dark:bg-zinc-950"
>
  <div class="mx-auto max-w-6xl">
    <!-- Encabezado de la Landing (Título y Descripción) -->
    <section class="mx-auto mb-16 max-w-3xl text-center">
      <h1
        class="mb-4 text-4xl font-extrabold tracking-tight text-zinc-900 sm:text-5xl dark:text-white"
      >
        Gestiona tus PDFs con facilidad
      </h1>
      <p class="text-lg text-zinc-600 dark:text-zinc-400">
        Herramientas rápidas, seguras y precisas para todas tus necesidades de
        documentos.
      </p>
    </section>

    <section class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      <FeatureCard
        title="Unificar PDF"
        description="Combina múltiples archivos PDF en un solo documento de forma rápida y sencilla."
        linkText="Comenzar"
        href="/unificar"
      >
        <div
          slot="icon"
          class="rounded-xl bg-red-50 p-3 text-red-600 dark:bg-red-950/50 dark:text-red-400"
        >
          <svg
            class="h-7 w-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2"
            ></path>
          </svg>
        </div>
      </FeatureCard>

      <FeatureCard
        title="Editar PDF"
        description="Modifica texto, imágenes y páginas directamente en tus documentos PDF sin complicaciones."
        linkText="Comenzar"
        href="/editar"
      >
        <div
          slot="icon"
          class="rounded-xl bg-blue-50 p-3 text-blue-600 dark:bg-blue-950/50 dark:text-blue-400"
        >
          <svg
            class="h-7 w-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
            ></path>
          </svg>
        </div>
      </FeatureCard>

      <FeatureCard
        title="PDF a Word"
        description="Convierte tus documentos PDF en formatos editables como Word manteniendo el formato original."
        linkText="Comenzar"
        href="/convertir"
      >
        <div
          slot="icon"
          class="rounded-xl bg-zinc-100 p-3 text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300"
        >
          <svg
            class="h-7 w-7"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
            ></path>
          </svg>
        </div>
      </FeatureCard>
    </section>
  </div>
</main>
