---
interface Props {
  title: string;
  description: string;
  linkText?: string;
  href?: string;
}

const { 
  title, 
  description, 
  linkText = "Comenzar", 
  href = "#" 
} = Astro.props;
---

<div class="flex flex-col justify-between p-6 bg-white dark:bg-zinc-900 rounded-2xl border border-zinc-200 dark:border-zinc-800 shadow-sm hover:shadow-md transition-shadow duration-200">
  <div>
    <div class="mb-4 inline-block">
      <slot name="icon" />
    </div>

    <h3 class="text-xl font-bold text-zinc-900 dark:text-white mb-2">
      {title}
    </h3>
    <p class="text-zinc-600 dark:text-zinc-400 text-sm leading-relaxed mb-6">
      {description}
    </p>
  </div>

  <a 
    href={href} 
    class="inline-flex items-center gap-1.5 text-sm font-semibold text-red-600 dark:text-red-500 hover:text-red-700 dark:hover:text-red-400 transition-colors w-fit"
  >
    <span>{linkText}</span>
    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
    </svg>
  </a>
</div>